# Match these values to the generator instance and TEPP.
PF_TOKEN_ENDPOINT=https://localhost:9031/as/token.oauth2
PF_ISSUER=https://localhost:9031
PF_JWKS_URI=https://localhost:9031/pf/JWKS
PF_CLIENT_ID=xaa-primary-client
PF_CLIENT_SECRET=
SUBJECT_TOKEN=
SUBJECT_TOKEN_TYPE=urn:ietf:params:oauth:token-type:id_token
TARGET_ISSUER=https://target.example.test
TARGET_RESOURCE=https://api.example.test/reports
TARGET_CLIENT_ID=target-client
XAA_SCOPE=read:reports
# Enable redemption only once the receiving AS is configured.
XAA_REDEEM=false
TARGET_TOKEN_ENDPOINT=https://target.example.test/oauth/token
TARGET_CLIENT_SECRET=
