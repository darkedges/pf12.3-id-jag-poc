<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.darkedges.pingfederate</groupId>
  <artifactId>xaa-id-jag-generator</artifactId>
  <version>0.1.0</version>
  <properties>
    <maven.compiler.source>11</maven.compiler.source>
    <maven.compiler.target>11</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <pf.install.dir>${env.PF_INSTALL_DIR}</pf.install.dir>
  </properties>
  <!-- All these libraries are supplied by PF. Never bundle the server jars. -->
  <dependencies>
    <dependency><groupId>javax.servlet</groupId><artifactId>javax.servlet-api</artifactId><version>provided</version><scope>system</scope><systemPath>${pf.install.dir}/sdk/lib/servlet-api.jar</systemPath></dependency>
    <dependency><groupId>com.pingidentity</groupId><artifactId>sdk</artifactId><version>12.3.3</version><scope>system</scope><systemPath>${pf.install.dir}/server/default/lib/pingfederate-sdk.jar</systemPath></dependency>
    <dependency><groupId>com.pingidentity</groupId><artifactId>protocolengine</artifactId><version>12.3.3</version><scope>system</scope><systemPath>${pf.install.dir}/server/default/lib/pf-protocolengine.jar</systemPath></dependency>
    <dependency><groupId>com.pingidentity</groupId><artifactId>jose4j</artifactId><version>provided</version><scope>system</scope><systemPath>${pf.install.dir}/server/default/lib/jose4j.jar</systemPath></dependency>
  </dependencies>
  <build><finalName>xaa-id-jag-generator</finalName></build>
</project>
